# 複製為 .env 後填入金鑰（.env 已被 .gitignore 排除，不會提交）。
# 也可以不建立 .env，直接在 shell 設定同名環境變數；已存在的環境變數優先。
# 不要把金鑰貼進程式碼、設定檔、提示詞或對話中。

OPENAI_API_KEY=
GEMINI_API_KEY=

# 選填：覆寫 imagegen.toml 的預設值（模型須已列在 imagegen.toml）
# IMAGEGEN_DEFAULT_PROVIDER=openai
# IMAGEGEN_OPENAI_MODEL=gpt-image-2
# IMAGEGEN_GEMINI_MODEL=gemini-2.5-flash-image
